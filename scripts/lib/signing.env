# Dev signing key identifiers. Sourced by common.sh and by args.sh (which runs
# standalone and must not pull in adb). Keep the values in sync with
# keys/README.md — that file is the public statement of record.
#
# This key is tracked in git ON PURPOSE: it only signs debug/self-test builds,
# and a stable key is what makes `pm install -r` (upgrade in place) work.
LUMO_KEY_ALIAS="${LUMO_KEY_ALIAS:-lumo}"
LUMO_KEY_PASSWORD="${LUMO_KEY_PASSWORD:-lumodebug}"
# GN only resolves //-relative paths, so the key is staged inside the checkout.
LUMO_KEY_GN_DIR="${LUMO_KEY_GN_DIR:-//lumo-signing}"
