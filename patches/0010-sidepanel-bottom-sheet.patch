+
+package org.chromium.chrome.browser.ui.side_panel;
+
+import android.app.Activity;
+import android.content.Context;
+import android.graphics.drawable.GradientDrawable;
+import android.util.TypedValue;
+import android.view.Gravity;
+import android.view.MotionEvent;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.FrameLayout;
+import android.widget.LinearLayout;
+
+import androidx.annotation.Nullable;
+
+import org.chromium.build.annotations.NullMarked;
+
+/**
+ * Lumo: hosts the side panel as a draggable bottom sheet on narrow (phone) windows.
+ *
+ * <p>Unlike the side-by-side layout used on wide windows, the sheet never squeezes the page: it is
+ * attached to the activity's content view as an overlay, so the page keeps its full width and stays
+ * interactive above the sheet. The panel content itself is kept attached when the sheet is
+ * collapsed to its peek height, so collapsing never tears down the extension's WebContents.
+ */
+@NullMarked
+class SidePanelBottomSheet {
+    /** Height of the collapsed "peek" state: drag handle + header row. */
+    private static final int PEEK_DP = 64;
+
+    private static final float COLLAPSED_RATIO = 0.45f;
+    private static final float EXPANDED_RATIO = 0.75f;
+
+    private final Context mContext;
+    private final FrameLayout mContainerView;
+    private final LinearLayout mInnerContainerView;
+    private final View mHandleView;
+
+    private @Nullable ViewGroup mHost;
+    private int mHeightPx;
+    private int mPeekPx;
+    private int mCollapsedPx;
+    private int mExpandedPx;
+
+    SidePanelBottomSheet(
+            Activity activity, FrameLayout containerView, LinearLayout innerContainerView) {
+        mContext = activity;
+        mContainerView = containerView;
+        mInnerContainerView = innerContainerView;
+        mHandleView = createHandleView();
+        mHandleView.setOnTouchListener(this::onHandleTouch);
+        mHandleView.setOnClickListener(v -> togglePeek());
+        // NOTE: the handle is only added while the sheet is attached. Wide windows keep the
+        // side-by-side panel and must not lose 24dp of header touch targets to a hidden handle.
+        mPeekPx = dp(PEEK_DP);
+        mHeightPx = -1; // Set on attach.
+    }
+
+    private View createHandleView() {
+        FrameLayout touchArea = new FrameLayout(mContext);
+        View bar = new View(mContext);
+        GradientDrawable bg = new GradientDrawable();
+        bg.setColor(0x33000000);
+        bg.setCornerRadius(dp(2));
+        bar.setBackground(bg);
+        FrameLayout.LayoutParams barParams =
+                new FrameLayout.LayoutParams(dp(36), dp(4), Gravity.CENTER);
+        touchArea.addView(bar, barParams);
+        touchArea.setContentDescription("拖动调整侧栏高度");
+        return touchArea;
+    }
+
+    private int dp(int value) {
+        return (int) TypedValue.applyDimension(
+                TypedValue.COMPLEX_UNIT_DIP, value, mContext.getResources().getDisplayMetrics());
+    }
+
+    /** Whether the sheet is currently attached to the activity's content view. */
+    boolean isAttached() {
+        return mHost != null && mContainerView.getParent() == mHost;
+    }
+
+    /** Adds the drag handle above the panel header (idempotent). */
+    private void attachHandle() {
+        if (mHandleView.getParent() != null) return;
+        LinearLayout.LayoutParams touchParams =
+                new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, dp(24));
+        mInnerContainerView.addView(mHandleView, 0, touchParams);
+    }
+
+    /** Removes the drag handle (used when switching to the side-by-side presentation). */
+    private void detachHandle() {
+        if (mHandleView.getParent() instanceof ViewGroup) {
+            ((ViewGroup) mHandleView.getParent()).removeView(mHandleView);
+        }
+    }
+
+    /** Attaches the sheet to the activity content view at its current height. */
+    void attach() {
+        if (isAttached()) return;
+        attachHandle();
+        Activity activity = (Activity) mContext;
+        View content = activity.findViewById(android.R.id.content);
+        if (!(content instanceof ViewGroup)) return;
+        if (mContainerView.getParent() instanceof ViewGroup) {
+            ((ViewGroup) mContainerView.getParent()).removeView(mContainerView);
+        }
+        recomputeHeights(content.getHeight() > 0 ? content.getHeight() : screenHeightPx());
+        if (mHeightPx <= 0) mHeightPx = mCollapsedPx;
+        FrameLayout.LayoutParams lp =
+                new FrameLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, mHeightPx);
+        lp.gravity = Gravity.BOTTOM;
+        mHost = (ViewGroup) content;
+        mHost.addView(mContainerView, lp);
+        mContainerView.setElevation(dp(12));
+        mContainerView.requestLayout();
+    }
+
+    /** Detaches the sheet (panel is being closed or switching to side-by-side). */
+    void detach() {
+        if (mContainerView.getParent() instanceof ViewGroup) {
+            ((ViewGroup) mContainerView.getParent()).removeView(mContainerView);
+        }
+        detachHandle();
+        mHost = null;
+    }
+
+    /**
+     * Normalizes the container for the side-by-side presentation (wide windows) without
+     * reparenting it: the side UI pass that follows moves it back to the anchor container.
+     */
+    void prepareForWideLayout() {
+        detachHandle();
+        ViewGroup.LayoutParams params = mContainerView.getLayoutParams();
+        if (params != null) {
+            params.height = ViewGroup.LayoutParams.MATCH_PARENT;
+            mContainerView.setLayoutParams(params);
+        }
+        mHeightPx = -1;
+    }
+
+    /** Applies the sheet's layout params; the sheet ignores the side-by-side reserved width. */
+    void updateLayout() {
+        if (!isAttached()) return;
+        ViewGroup.LayoutParams params = mContainerView.getLayoutParams();
+        if (params instanceof FrameLayout.LayoutParams frameParams) {
+            frameParams.width = ViewGroup.LayoutParams.MATCH_PARENT;
+            frameParams.height = mHeightPx;
+            frameParams.gravity = Gravity.BOTTOM;
+            mContainerView.setLayoutParams(frameParams);
+        }
+    }
+
+    private int screenHeightPx() {
+        return mContext.getResources().getDisplayMetrics().heightPixels;
+    }
+
+    private void recomputeHeights(int availableHeightPx) {
+        int max = (int) (availableHeightPx * EXPANDED_RATIO);
+        mExpandedPx = Math.max(mPeekPx * 2, max);
+        mCollapsedPx = Math.max(mPeekPx + dp(24), (int) (availableHeightPx * COLLAPSED_RATIO));
+        mExpandedPx = Math.max(mExpandedPx, mCollapsedPx);
+    }
+
+    private void setHeightPx(int heightPx) {
+        mHeightPx = Math.max(mPeekPx, Math.min(heightPx, mExpandedPx));
+        updateLayout();
+    }
+
+    private void togglePeek() {
+        setHeightPx(mHeightPx <= mPeekPx + dp(4) ? mCollapsedPx : mPeekPx);
+    }
+
+    private boolean onHandleTouch(View view, MotionEvent event) {
+        switch (event.getActionMasked()) {
+            case MotionEvent.ACTION_DOWN:
+                mDragStartY = event.getRawY();
+                mDragStartHeight = mHeightPx;
+                return true;
+            case MotionEvent.ACTION_MOVE:
+                if (mDragStartY < 0) return false;
+                int delta = (int) (mDragStartY - event.getRawY());
+                if (Math.abs(delta) > dp(4)) mDragged = true;
+                // Dragging up grows the sheet, dragging down shrinks it.
+                setHeightPx(mDragStartHeight + delta);
+                return true;
+            case MotionEvent.ACTION_UP:
+            case MotionEvent.ACTION_CANCEL:
+                boolean wasDrag = mDragged;
+                mDragStartY = -1;
+                mDragged = false;
+                snapToNearestState();
+                if (!wasDrag) view.performClick();
+                return true;
+            default:
+                return false;
+        }
+    }
+
+    private float mDragStartY = -1;
+    private int mDragStartHeight;
+    private boolean mDragged;
+
+    private void snapToNearestState() {
+        int[] states = {mPeekPx, mCollapsedPx, mExpandedPx};
+        int best = states[0];
+        for (int state : states) {
+            if (Math.abs(state - mHeightPx) < Math.abs(best - mHeightPx)) best = state;
+        }
+        setHeightPx(best);
+    }
+
+    /** Whether the sheet is collapsed to the peek height. */
+    boolean isPeeking() {
+        return mHeightPx <= mPeekPx + dp(4);
+    }
+}
