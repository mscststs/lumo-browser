+    /**
+     * Lumo: returns the app-scoped command line file if present and readable.
+     *
+     * <p>Only used by builds whose embedder opts in (see Patch 0001 header); the
+     * file is app-private storage on external media, so no other app can write
+     * it without the user's explicit action.
+     */
+    private static @Nullable File getExternalCommandLineFile(String fileName) {
+        if (sExternalCommandLineFileForTesting != null) return sExternalCommandLineFileForTesting;
+        Context context = ContextUtils.getApplicationContext();
+        File dir = context.getExternalFilesDir(null);
+        if (dir == null) return null;
+        File file = new File(dir, fileName);
+        return file.isFile() && file.canRead() ? file : null;
+    }
+
+    /** Lumo: override the app-scoped command line file (tests). */
